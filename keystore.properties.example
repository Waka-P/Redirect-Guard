# keystore.properties.example
#
# リリース署名を行うには、このファイルを "keystore.properties" にリネームして
# 実際の値を入力してください(keystore.properties 自体は .gitignore 済みでコミットされません)。
#
# 署名鍵の作成例(まだ持っていない場合):
#   keytool -genkey -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias redirectguard
#
# storeFile はこのファイル(プロジェクトルート)からの相対パス、または絶対パスで指定してください。

storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=redirectguard
keyPassword=CHANGE_ME
